PORT=7000
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codeforge?retryWrites=true&w=majority
JWT_KEY=your_super_secret_jwt_key
REDIS_PASS=your_redis_cloud_password

# Public or Self-Hosted Judge0 CE API
JUDGE0_URL=https://judge0-ce.p.rapidapi.com

# Groq AI Socratic Assistant
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Deployment (Vercel Frontend URL & Node Env)
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional Admin Credentials (seeded into database)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_admin_password_here
